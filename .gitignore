# IDE
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
.venv/

# Database (generated at build time)
*.db

# Terraform — downloaded providers and modules
infra/**/.terraform/

# Terraform — state files and lock info
infra/**/terraform.tfstate
infra/**/terraform.tfstate.backup
infra/**/.terraform.tfstate.lock.info

# Terraform — saved plan files
infra/**/*.tfplan

# Terraform — variable files that may contain sensitive values
infra/**/*.tfvars
